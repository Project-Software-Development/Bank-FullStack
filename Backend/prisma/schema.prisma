generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  nome          String
  cpf           String         @unique
  email         String         @unique
  telefone      String?
  senha         String
  tipo          String
  statusConta   String         @default("ATIVO")
  createdAt     DateTime       @default(now())
  conta         Conta?
  notifications Notification[]
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Conta {
  id                  String      @id @default(uuid())
  numero              String      @unique
  saldo               Decimal     @default(0)
  status              String      @default("ATIVA")
  createdAt           DateTime    @default(now())
  userId              String      @unique
  user                User        @relation(fields: [userId], references: [id])
  transacoesRecebidas Transacao[] @relation("ContaDestino")
  transacoesEnviadas  Transacao[] @relation("ContaOrigem")
}

model Transacao {
  id             String   @id @default(uuid())
  tipo           String   @default("TRANSFERENCIA")
  valor          Decimal
  descricao      String?
  createdAt      DateTime @default(now())
  contaOrigemId  String
  contaDestinoId String
  contaDestino   Conta    @relation("ContaDestino", fields: [contaDestinoId], references: [id])
  contaOrigem    Conta    @relation("ContaOrigem", fields: [contaOrigemId], references: [id])

  @@index([contaOrigemId, createdAt])
  @@index([contaDestinoId, createdAt])
}
